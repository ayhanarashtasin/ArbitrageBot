# ==============================================================================
# Runtime. Paper mode is the only mode that can start today.
# ==============================================================================
RUN_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=

DATABASE_URL=sqlite:///data/arbitrage.db
# docker-compose sets PostgreSQL for you; for a manual install use, e.g.:
# DATABASE_URL=postgresql+psycopg://bot:password@localhost:5432/arbitrage
POSTGRES_PASSWORD=

# Which coins to scan: ALL = every coin Zero Delta lists (about 430), or a list such as BTC,ETH,SOL
SCAN_ASSETS=ALL
# Coins to skip, comma separated. Stocks otherwise require an earnings-calendar clearance.
EXCLUDE_ASSETS=

# Long random string. Enables the kill-switch endpoints (/admin/*). Unset = admin API disabled.
ADMIN_API_TOKEN=

# ==============================================================================
# Zero Delta (never commit real values). The cookie expires: refresh it when the alert fires.
# ==============================================================================
ZERO_DELTA_ENABLED=true
ZERO_DELTA_SESSION_COOKIE=
ZERO_DELTA_USER_ID=

# Locked: cannot be set below these
ZERO_DELTA_MIN_AVG_24H_VOLUME_USD=5000000
ZERO_DELTA_PRIMARY_LOOKBACK_DAYS=7
ZERO_DELTA_MIN_LOOKBACK_DAYS=7

# Not specified in project.md: implementation defaults, confirm or change
ZERO_DELTA_REQUEST_TIMEOUT_SECONDS=20
ZERO_DELTA_MAX_RETRIES=2
ZERO_DELTA_RETRY_BACKOFF_SECONDS=0.5
# Missing hourly points tolerated inside the 7-day window (0 = strict)
ZERO_DELTA_MAX_MISSING_INTERVALS=0
# Venue types you have verified, as JSON, e.g. {"Arcus":"DEX"}. Built-in types are provisional.
ZERO_DELTA_VENUE_TYPES=

# ==============================================================================
# Locked strategy values (project.md). The bot refuses to start if these are loosened.
# ==============================================================================
MAX_ALLOWED_LEVERAGE=4
TWAP_ENTRY_DURATION_MINUTES=360
TWAP_MAX_CHILD_NOTIONAL_USD=100
LOW_VOL_MAX_PERCENTILE=45
FUNDING_SCREENING_HORIZON_MINUTES=120
CONTROLLED_EXIT_EQUITY_RATIO=0.30
CONTROLLED_EXIT_DURATION_MINUTES=180
EMERGENCY_EXIT_EQUITY_RATIO=0.10
EMERGENCY_EXIT_TARGET_SECONDS=60

# ==============================================================================
# REQUIRED_BEFORE_LIVE. Leave blank in paper mode: the bot uses labelled paper defaults
# (see app/core/trading_config.py) and says so at startup. Live mode needs every one of
# these set explicitly, and live orders are not implemented yet.
# ==============================================================================
TARGET_NOTIONAL_PER_LEG_USD=
TARGET_LEVERAGE=

RV_WINDOW_MINUTES=
BASIS_VOL_WINDOW_MINUTES=
VOL_PERCENTILE_LOOKBACK_DAYS=
VOL_MIN_OBSERVATIONS=

MIN_EXPECTED_NET_EDGE_BPS=
MAX_ALLOWED_SLIPPAGE_BPS=
MIN_REQUIRED_BOOK_DEPTH_MULTIPLIER=
MAX_MARKET_DATA_AGE_MS=

MAX_DELTA_IMBALANCE_USD=
MAX_DELTA_IMBALANCE_RATIO=
DELTA_HEDGE_TIMEOUT_MS=

MIN_LIQUIDATION_DISTANCE_PCT=
MAX_MARGIN_UTILIZATION_PCT=

MAX_CONCURRENT_TRADES=
MAX_TOTAL_GROSS_NOTIONAL_USD=
MAX_NOTIONAL_PER_VENUE_USD=
MAX_NOTIONAL_PER_ASSET_USD=

NORMAL_EXIT_POLICY=

# ==============================================================================
# Design parameters (optional; defaults are in app/core/trading_config.py)
# ==============================================================================
EXPECTED_HOLD_HOURS=
NORMAL_EXIT_EDGE_FLOOR_BPS_PER_HOUR=
NORMAL_EXIT_CONFIRM_MINUTES=
MAX_HOLD_HOURS=
NORMAL_EXIT_DURATION_MINUTES=
SCAN_INTERVAL_SECONDS=
# Gentle on Zero Delta: coins fetched at once, and the pause after each request
SWEEP_CONCURRENCY=
SWEEP_DELAY_SECONDS=
# How many best pairs are selected each sweep, and the ranking metric (mean or median 7-day edge)
SELECTION_COUNT=
SELECTION_METRIC=
SELECTION_ONE_PER_ASSET=true
SELECTION_REQUIRE_LIVE_EDGE=true
# Research trials use the same engine and Alex's rules; the net-edge rejection remains visible.
SHADOW_PAPER_ENABLED=true
ENTRY_SLICE_GATES=true
WATCH_INTERVAL_SECONDS=60
# Default equity per side = target notional / target leverage (1 = true target leverage)
PAPER_ACCOUNT_EQUITY_MULTIPLE=1
SIMULATION_SLIPPAGE_BPS=2
# Both legs' mid prices must agree within this percent (a larger gap means two assets share a ticker)
MAX_LEG_PRICE_GAP_PCT=5
# No stock entry within +/- this many calendar days of earnings; crypto is unaffected.
EARNINGS_BLACKOUT_DAYS=3
EARNINGS_AUTO_FETCH=true
# Optional file containing SYMBOL,YYYY-MM-DD rows (particularly for non-US stocks)
EARNINGS_CALENDAR_FILE=

# ==============================================================================
# Notifications (off by default)
# ==============================================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# Venue API keys are NOT used yet: paper mode reads public market data only.
# Trading keys must never have withdrawal permission (project.md section 59).
# ==============================================================================
